# Docker 全栈启动可覆盖项示例
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
# 修改后重新执行 docker compose up -d 生效。

# ---- 端口映射 ----
# 前端访问端口：浏览器打开 http://localhost:<FRONTEND_HOST_PORT>
FRONTEND_HOST_PORT=3000
# 数据库宿主机端口：默认 5432；如被其他程序占用可改为 5434 等空闲端口
POSTGRES_HOST_PORT=5432

# ---- 数据库账号（postgres 服务与后端连接共用，需成对修改）----
POSTGRES_DB=agentwriter
POSTGRES_USER=agentwriter
POSTGRES_PASSWORD=agentwriter_secret

# ---- 外网代理（可选，默认直连）----
# 注意：仅监听 127.0.0.1 的宿主代理（如 Clash 默认配置）无法从容器访问；
# 如需容器走代理，请开启代理的 allow-lan（监听 0.0.0.0）后填写宿主局域网 IP。
# TOPIC_PROXY_HOST=192.168.2.8
# TOPIC_PROXY_PORT=7890
TOPIC_PROXY_HOST=
TOPIC_PROXY_PORT=0
